{
  "manifest_version": 3,
  "name": "Serendipity Drift: 비틀린 사유의 궤적",
  "version": "2.0.0",
  "minimum_chrome_version": "128",
  "description": "Chrome 내장 Gemini Nano 모델을 활용해 검색창의 의도를 살짝 비틀고 낯선 사유의 결과를 발견하는 온디바이스 검색 확장 프로그램",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Serendipity Drift"
  },
  "omnibox": {
    "keyword": "drift"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/",
        "https://www.google.com/?*",
        "https://www.google.com/webhp*",
        "https://www.google.com/search*",
        "https://www.google.co.kr/",
        "https://www.google.co.kr/?*",
        "https://www.google.co.kr/webhp*",
        "https://www.google.co.kr/search*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://www.youtube.com/*"
  ]
}
